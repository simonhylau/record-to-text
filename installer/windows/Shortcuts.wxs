<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shortcuts.wxs — Start Menu and Desktop shortcuts.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
	<ComponentGroup Id="ShortcutsGroup" Directory="INSTALLFOLDER">

	  <!-- Start Menu shortcut -->
	  <Component Id="StartMenuShortcut" Guid="B1C2D3E4-F5A6-7890-BCDE-F01234567890">
		<Shortcut
		  Id="StartMenuShortcutEntry"
		  Directory="STARTMENUFOLDER"
		  Name="Local Whisper Transcriber"
		  Description="Offline speech-to-text powered by whisper.cpp"
		  Target="[INSTALLFOLDER]LocalWhisperTranscriber.exe"
		  WorkingDirectory="INSTALLFOLDER"
		  Icon="AppIcon" />
		<RemoveFolder Id="CleanStartMenu" Directory="STARTMENUFOLDER" On="uninstall" />
		<RegistryValue
		  Root="HKCU"
		  Key="Software\SimonHyLau\LocalWhisperTranscriber"
		  Name="StartMenuInstalled"
		  Type="integer"
		  Value="1"
		  KeyPath="yes" />
	  </Component>

	  <!-- Desktop shortcut -->
	  <Component Id="DesktopShortcut" Guid="C2D3E4F5-A6B7-8901-CDEF-012345678901">
		<Shortcut
		  Id="DesktopShortcutEntry"
		  Directory="DesktopFolder"
		  Name="Local Whisper Transcriber"
		  Description="Offline speech-to-text powered by whisper.cpp"
		  Target="[INSTALLFOLDER]LocalWhisperTranscriber.exe"
		  WorkingDirectory="INSTALLFOLDER"
		  Icon="AppIcon" />
		<RegistryValue
		  Root="HKCU"
		  Key="Software\SimonHyLau\LocalWhisperTranscriber"
		  Name="DesktopInstalled"
		  Type="integer"
		  Value="1"
		  KeyPath="yes" />
	  </Component>

	</ComponentGroup>

	<!-- Icon reference (must match an .ico file harvested or listed in AppFiles.wxs) -->
	<Icon Id="AppIcon" SourceFile="$(var.PublishDir)LocalWhisperTranscriber.exe" />

  </Fragment>
</Wix>
