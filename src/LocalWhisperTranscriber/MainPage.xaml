<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalWhisperTranscriber.MainPage"
             Title="Local Whisper Transcriber"
             BackgroundColor="{AppThemeBinding Light=#F5F5F7, Dark=#1C1C1E}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="0">

            <!-- ═══════════════════ HEADER ═══════════════════ -->
            <Label Text="🎙 Local Whisper Transcriber"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#F5F5F7}"
                   HorizontalOptions="Start"
                   Margin="0,0,0,4" />
            <Label Text="Fully offline speech-to-text powered by whisper.cpp"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}"
                   Margin="0,0,0,24" />

            <!-- ═══════════════════ AUDIO INPUT ═══════════════════ -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   Padding="16" Margin="0,0,0,16" CornerRadius="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Audio Input" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}" />

                    <!-- Upload + Record buttons -->
                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="BtnSelectFile"
                                Text="📂  Upload Audio"
                                Clicked="OnSelectFileClicked"
                                HorizontalOptions="Start" />
                        <Button x:Name="BtnRecord"
                                Text="🔴  Record Audio"
                                Clicked="OnRecordClicked"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Start" />
                        <Label x:Name="LblSelectedFile"
                               Text="No file selected"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}"
                               FontSize="13"
                               LineBreakMode="MiddleTruncation"
                               MaximumWidthRequest="400" />
                        <Label x:Name="LblRecordingTime"
                               Text="● 00:00"
                               IsVisible="False"
                               VerticalOptions="Center"
                               TextColor="#FF3B30"
                               FontSize="13"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <!-- Input device + system audio row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Input Device" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}" />
                            <Picker x:Name="PickerInputDevice" Title="Default microphone" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4"
                                             x:Name="SystemAudioPanel"
                                             IsVisible="False"
                                             VerticalOptions="End">
                            <Label Text="Include System Audio" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}"
                                   HorizontalOptions="Center" />
                            <Switch x:Name="SwitchSystemAudio"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- ═══════════════════ OPTIONS ═══════════════════ -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   Padding="16" Margin="0,0,0,16" CornerRadius="12">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">

                    <!-- Model -->
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Model" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}" />
                        <Picker x:Name="PickerModel" Title="Select model"
                                SelectedIndexChanged="OnOptionChanged">
                            <Picker.Items>
                                <x:String>tiny</x:String>
                                <x:String>base</x:String>
                                <x:String>small</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!-- Language -->
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Language" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}" />
                        <Picker x:Name="PickerLanguage" Title="Select language"
                                SelectedIndexChanged="OnOptionChanged">
                            <Picker.Items>
                                <x:String>auto</x:String>
                                <x:String>English</x:String>
                                <x:String>Chinese</x:String>
                                <x:String>Cantonese</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!-- Output format -->
                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="Output Format" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}" />
                        <Picker x:Name="PickerFormat" Title="Select format"
                                SelectedIndexChanged="OnOptionChanged">
                            <Picker.Items>
                                <x:String>txt</x:String>
                                <x:String>srt</x:String>
                                <x:String>json</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                </Grid>
            </Frame>

            <!-- ═══════════════════ ACTIONS ═══════════════════ -->
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,16">
                <Button x:Name="BtnTranscribe"
                        Text="▶  Transcribe"
                        Clicked="OnTranscribeClicked"
                        IsEnabled="False"
                        MinimumWidthRequest="140" />
                <Button x:Name="BtnCancel"
                        Text="✕  Cancel"
                        Clicked="OnCancelClicked"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="BtnSave"
                        Text="💾  Save Transcript"
                        Clicked="OnSaveClicked"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="BtnOpenFolder"
                        Text="📂  Open Output Folder"
                        Clicked="OnOpenFolderClicked"
                        Style="{StaticResource SecondaryButton}" />
            </HorizontalStackLayout>

            <!-- ═══════════════════ PROGRESS ═══════════════════ -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   Padding="14,10" Margin="0,0,0,16" CornerRadius="12">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <ActivityIndicator x:Name="BusyIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="20" HeightRequest="20" />
                        <Label x:Name="LblStatus"
                               Text="Ready"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#1D1D1F, Dark=#F5F5F7}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ═══════════════════ TRANSCRIPT OUTPUT ═══════════════════ -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   Padding="0" CornerRadius="12" HeightRequest="360">
                <VerticalStackLayout>
                    <Label Text="Transcript Output"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#6E6E73, Dark=#98989D}"
                           Margin="14,10,14,6" />
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Editor x:Name="EditorTranscript"
                            Placeholder="Transcription will appear here…"
                            PlaceholderColor="{AppThemeBinding Light=#C7C7CC, Dark=#48484A}"
                            IsReadOnly="False"
                            AutoSize="TextChanges"
                            FontFamily="Courier New"
                            FontSize="13"
                            Margin="4,4"
                            MinimumHeightRequest="300"
                            BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </Frame>

            <!-- Bottom padding -->
            <BoxView HeightRequest="24" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
